+// subsonicSearch2 handles the search2 API endpoint (old tag format).
+func subsonicSearch2(c *gin.Context) {
+	results := runFastSubsonicSearch(c)
+	result := SubsonicSearchResult2{
+		Artists: mapArtistsForSearch(results.Artists),
+		Albums:  mapAlbumsForSearch(results.Albums),
+		Songs:   mapSongsForSearch(results.Songs),
+	}
+	response := newSubsonicResponse(&result)
+	subsonicRespond(c, response)
+}
+
+// subsonicSearch3 handles the search3 API endpoint (ID3 tag format).
+func subsonicSearch3(c *gin.Context) {
+	results := runFastSubsonicSearch(c)
+	result := SubsonicSearchResult3{
+		Artists: mapArtistsForSearch(results.Artists),
+		Albums:  mapAlbumsForSearch(results.Albums),
+		Songs:   mapSongsForSearch(results.Songs),
+	}
+	response := newSubsonicResponse(&result)
+	subsonicRespond(c, response)
+}
+
+func mapArtistsForSearch(artists []ArtistResult) []SubsonicArtist {
+	out := make([]SubsonicArtist, 0, len(artists))
+	for _, artist := range artists {
+		artistID := GenerateArtistID(artist.Name)
+		out = append(out, SubsonicArtist{
+			ID:         artistID,
+			Name:       artist.Name,
+			CoverArt:   artistID,
+			AlbumCount: artist.AlbumCount,
+			SongCount:  artist.SongCount,
+		})
+	}
+	return out
+}
+
+func mapAlbumsForSearch(albums []AlbumResult) []SubsonicAlbum {
+	out := make([]SubsonicAlbum, 0, len(albums))
+	for _, album := range albums {
+		artistID := GenerateArtistID(album.Artist)
+		out = append(out, SubsonicAlbum{
+			ID:        album.AlbumID,
+			Name:      album.Name,
+			Artist:    album.Artist,
+			ArtistID:  artistID,
+			Genre:     album.Genre,
+			CoverArt:  album.AlbumID,
+			SongCount: album.SongCount,
+			Duration:  album.Duration,
+			Created:   album.Created,
+		})
+	}
+	return out
+}
+
+func mapSongsForSearch(songs []SongResult) []SubsonicSong {
+	out := make([]SubsonicSong, 0, len(songs))
+	for _, song := range songs {
+		out = append(out, SubsonicSong{
+			ID:         song.ID,
+			Title:      song.Title,
+			Artist:     song.Artist,
+			ArtistID:   GenerateArtistID(song.Artist),
+			Album:      song.Album,
+			Genre:      song.Genre,
+			Duration:   song.Duration,
+			PlayCount:  song.PlayCount,
+			CoverArt:   song.ID,
+			Starred:    song.Starred,
+			LastPlayed: song.LastPlayed,
+		})
+	}
+	return out
+}
