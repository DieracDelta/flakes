+package main
+
+import (
+	"database/sql"
+	"encoding/xml"
+	"log"
+	"strconv"
+	"strings"
+	"sync"
+
+	"github.com/gin-gonic/gin"
+)
+
+// SubsonicSearchResult2 represents the structure for search2 responses.
+type SubsonicSearchResult2 struct {
+	XMLName     xml.Name         `xml:"searchResult2" json:"-"`
+	Artists     []SubsonicArtist `xml:"artist" json:"artist,omitempty"`
+	Albums      []SubsonicAlbum  `xml:"album" json:"album,omitempty"`
+	Songs       []SubsonicSong   `xml:"song" json:"song,omitempty"`
+	ArtistCount int              `xml:"artistCount,attr,omitempty" json:"artistCount,omitempty"`
+	AlbumCount  int              `xml:"albumCount,attr,omitempty" json:"albumCount,omitempty"`
+	SongCount   int              `xml:"songCount,attr,omitempty" json:"songCount,omitempty"`
+}
+
+// SubsonicSearchResult3 represents the structure for search3 responses (ID3 tags).
+type SubsonicSearchResult3 struct {
+	XMLName     xml.Name         `xml:"searchResult3" json:"-"`
+	Artists     []SubsonicArtist `xml:"artist" json:"artist,omitempty"`
+	Albums      []SubsonicAlbum  `xml:"album" json:"album,omitempty"`
+	Songs       []SubsonicSong   `xml:"song" json:"song,omitempty"`
+	ArtistCount int              `xml:"artistCount,attr,omitempty" json:"artistCount,omitempty"`
+	AlbumCount  int              `xml:"albumCount,attr,omitempty" json:"albumCount,omitempty"`
+	SongCount   int              `xml:"songCount,attr,omitempty" json:"songCount,omitempty"`
+}
+
+type subsonicSearchParams struct {
+	Query        string
+	SearchTerm   string
+	ArtistCount  int
+	ArtistOffset int
+	AlbumCount   int
+	AlbumOffset  int
+	SongCount    int
+	SongOffset   int
+}
+
+type fastSearchResults struct {
+	Artists []ArtistResult
+	Albums  []AlbumResult
+	Songs   []SongResult
+}
+
+func parseSubsonicSearchParams(c *gin.Context) subsonicSearchParams {
+	query := strings.TrimSpace(c.Query("query"))
+	p := subsonicSearchParams{
+		Query:        query,
+		ArtistCount:  parseNonNegativeInt(c.DefaultQuery("artistCount", "20")),
+		ArtistOffset: parseNonNegativeInt(c.DefaultQuery("artistOffset", "0")),
+		AlbumCount:   parseNonNegativeInt(c.DefaultQuery("albumCount", "20")),
+		AlbumOffset:  parseNonNegativeInt(c.DefaultQuery("albumOffset", "0")),
+		SongCount:    parseNonNegativeInt(c.DefaultQuery("songCount", "50")),
+		SongOffset:   parseNonNegativeInt(c.DefaultQuery("songOffset", "0")),
+	}
+	if query != "" && query != "*" && len(query) >= 2 {
+		p.SearchTerm = query
+	}
+	return p
+}
+
+func parseNonNegativeInt(s string) int {
+	n, _ := strconv.Atoi(s)
+	if n < 0 {
+		return 0
+	}
+	return n
+}
+
+func runFastSubsonicSearch(c *gin.Context) fastSearchResults {
+	user := c.MustGet("user").(User)
+	params := parseSubsonicSearchParams(c)
+
+	ensureLibraryDerivedTables(db)
+	rebuildLibraryIndexIfEmpty(db)
+
+	var results fastSearchResults
+	run := func() {
+		if params.ArtistCount > 0 {
+			artists, err := fastSearchArtists(db, params.SearchTerm, params.ArtistCount, params.ArtistOffset)
+			if err != nil {
+				log.Printf("[ERROR] search: artist query failed: %v", err)
+			} else {
+				results.Artists = artists
+			}
+		}
+		if params.AlbumCount > 0 {
+			albums, err := fastSearchAlbums(db, params.SearchTerm, params.AlbumCount, params.AlbumOffset)
+			if err != nil {
+				log.Printf("[ERROR] search: album query failed: %v", err)
+			} else {
+				results.Albums = albums
+			}
+		}
+		if params.SongCount > 0 {
+			songs, err := fastSearchSongs(db, params.SearchTerm, user.ID, params.SongCount, params.SongOffset)
+			if err != nil {
+				log.Printf("[ERROR] search: song query failed: %v", err)
+			} else {
+				results.Songs = songs
+			}
+		}
+	}
+
+	if sqliteMainDatabaseIsMemory(db) {
+		run()
+		return results
+	}
+
+	var wg sync.WaitGroup
+	if params.ArtistCount > 0 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			artists, err := fastSearchArtists(db, params.SearchTerm, params.ArtistCount, params.ArtistOffset)
+			if err != nil {
+				log.Printf("[ERROR] search: artist query failed: %v", err)
+				return
+			}
+			results.Artists = artists
+		}()
+	}
+	if params.AlbumCount > 0 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			albums, err := fastSearchAlbums(db, params.SearchTerm, params.AlbumCount, params.AlbumOffset)
+			if err != nil {
+				log.Printf("[ERROR] search: album query failed: %v", err)
+				return
+			}
+			results.Albums = albums
+		}()
+	}
+	if params.SongCount > 0 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			songs, err := fastSearchSongs(db, params.SearchTerm, user.ID, params.SongCount, params.SongOffset)
+			if err != nil {
+				log.Printf("[ERROR] search: song query failed: %v", err)
+				return
+			}
+			results.Songs = songs
+		}()
+	}
+	wg.Wait()
+	return results
+}
+
+func sqliteMainDatabaseIsMemory(d *sql.DB) bool {
+	rows, err := d.Query(`PRAGMA database_list`)
+	if err != nil {
+		return false
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var seq int
+		var name, file string
+		if err := rows.Scan(&seq, &name, &file); err != nil {
+			continue
+		}
+		if name == "main" {
+			return file == ""
+		}
+	}
+	return false
+}
+
+func fastSearchArtists(d *sql.DB, term string, limit, offset int) ([]ArtistResult, error) {
+	if limit <= 0 {
+		return nil, nil
+	}
+	var rows *sql.Rows
+	var err error
+	if term != "" && ftsAvailable(d) && derivedFTSAvailable(d) {
+		rows, err = d.Query(`
+			SELECT a.name, a.song_count, a.album_count
+			FROM artists_fts
+			JOIN artists a ON a.rowid = artists_fts.rowid
+			WHERE artists_fts MATCH ?
+			ORDER BY bm25(artists_fts), a.name COLLATE NOCASE
+			LIMIT ? OFFSET ?`, buildFTSQuery(term), limit, offset)
+	} else if term != "" {
+		pattern := "%" + term + "%"
+		rows, err = d.Query(`
+			SELECT name, song_count, album_count
+			FROM artists
+			WHERE search_text LIKE ? OR name LIKE ?
+			ORDER BY name COLLATE NOCASE
+			LIMIT ? OFFSET ?`, pattern, pattern, limit, offset)
+	} else {
+		rows, err = d.Query(`
+			SELECT name, song_count, album_count
+			FROM artists
+			ORDER BY name COLLATE NOCASE
+			LIMIT ? OFFSET ?`, limit, offset)
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+
+	var artists []ArtistResult
+	for rows.Next() {
+		var a ArtistResult
+		if err := rows.Scan(&a.Name, &a.SongCount, &a.AlbumCount); err != nil {
+			return nil, err
+		}
+		artists = append(artists, a)
+	}
+	return artists, rows.Err()
+}
+
+func fastSearchAlbums(d *sql.DB, term string, limit, offset int) ([]AlbumResult, error) {
+	if limit <= 0 {
+		return nil, nil
+	}
+	var rows *sql.Rows
+	var err error
+	if term != "" && ftsAvailable(d) && derivedFTSAvailable(d) {
+		rows, err = d.Query(`
+			SELECT a.name, a.album_path, a.artist, a.genre, a.id, a.song_count, a.total_duration, COALESCE(a.min_date_added, '')
+			FROM albums_fts
+			JOIN albums a ON a.rowid = albums_fts.rowid
+			WHERE albums_fts MATCH ?
+			ORDER BY bm25(albums_fts), a.name COLLATE NOCASE
+			LIMIT ? OFFSET ?`, buildFTSQuery(term), limit, offset)
+	} else if term != "" {
+		pattern := "%" + term + "%"
+		rows, err = d.Query(`
+			SELECT name, album_path, artist, genre, id, song_count, total_duration, COALESCE(min_date_added, '')
+			FROM albums
+			WHERE search_text LIKE ? OR name LIKE ? OR artist LIKE ?
+			ORDER BY name COLLATE NOCASE
+			LIMIT ? OFFSET ?`, pattern, pattern, pattern, limit, offset)
+	} else {
+		rows, err = d.Query(`
+			SELECT name, album_path, artist, genre, id, song_count, total_duration, COALESCE(min_date_added, '')
+			FROM albums
+			ORDER BY name COLLATE NOCASE
+			LIMIT ? OFFSET ?`, limit, offset)
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+
+	var albums []AlbumResult
+	for rows.Next() {
+		var a AlbumResult
+		if err := rows.Scan(&a.Name, &a.AlbumPath, &a.Artist, &a.Genre, &a.AlbumID, &a.SongCount, &a.Duration, &a.Created); err != nil {
+			return nil, err
+		}
+		albums = append(albums, a)
+	}
+	return albums, rows.Err()
+}
+
+func fastSearchSongs(d *sql.DB, term string, userID, limit, offset int) ([]SongResult, error) {
+	if limit <= 0 {
+		return nil, nil
+	}
+	if term == "" {
+		return QuerySongs(d, SongQueryOptions{
+			SearchTerm:     term,
+			IncludeStarred: true,
+			IncludeGenre:   true,
+			UserID:         userID,
+			Limit:          limit,
+			Offset:         offset,
+			OrderBy:        "s.artist, s.album, s.title COLLATE NOCASE",
+		})
+	}
+
+	if songSearchFTSAvailable(d) {
+		if len([]rune(term)) == 2 {
+			return fastSearchSongsFromIndexUnranked(d, term, userID, limit, offset)
+		}
+		return fastSearchSongsFromIndex(d, term, userID, limit, offset)
+	}
+
+	if !ftsAvailable(d) {
+		return QuerySongs(d, SongQueryOptions{
+			SearchTerm:     term,
+			IncludeStarred: true,
+			IncludeGenre:   true,
+			UserID:         userID,
+			Limit:          limit,
+			Offset:         offset,
+			OrderBy:        "s.artist, s.album, s.title COLLATE NOCASE",
+		})
+	}
+
+	rows, err := d.Query(`
+		WITH ranked AS (
+			SELECT s.rowid, bm25(songs_fts) AS rank, s.title AS title_sort
+			FROM songs_fts
+			JOIN songs s ON s.rowid = songs_fts.rowid
+			WHERE songs_fts MATCH ? AND s.cancelled = 0
+			ORDER BY rank, title_sort COLLATE NOCASE
+			LIMIT ? OFFSET ?
+		)
+		SELECT s.id, s.title, s.artist, s.album, s.path, s.duration, s.play_count,
+		       s.last_played, COALESCE(s.genre, '') AS genre,
+		       CASE WHEN ss.song_id IS NOT NULL THEN 1 ELSE 0 END AS starred
+		FROM ranked
+		JOIN songs s ON s.rowid = ranked.rowid
+		LEFT JOIN starred_songs ss ON s.id = ss.song_id AND ss.user_id = ?
+		ORDER BY ranked.rank, ranked.title_sort COLLATE NOCASE`, buildFTSQuery(term), limit, offset, userID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+
+	var songs []SongResult
+	for rows.Next() {
+		var s SongResult
+		var title, artist, album, path, lastPlayed, genre sql.NullString
+		var duration, playCount, starred sql.NullInt64
+		if err := rows.Scan(&s.ID, &title, &artist, &album, &path, &duration, &playCount, &lastPlayed, &genre, &starred); err != nil {
+			return nil, err
+		}
+		if title.Valid {
+			s.Title = title.String
+		}
+		if artist.Valid {
+			s.Artist = artist.String
+		}
+		if album.Valid {
+			s.Album = album.String
+		}
+		if path.Valid {
+			s.Path = path.String
+		}
+		if duration.Valid {
+			s.Duration = int(duration.Int64)
+		}
+		if playCount.Valid {
+			s.PlayCount = int(playCount.Int64)
+		}
+		if lastPlayed.Valid {
+			s.LastPlayed = lastPlayed.String
+		}
+		if genre.Valid {
+			s.Genre = genre.String
+		}
+		s.Starred = starred.Valid && starred.Int64 == 1
+		songs = append(songs, s)
+	}
+	return songs, rows.Err()
+}
