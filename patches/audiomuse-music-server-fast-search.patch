+func fastSearchSongsFromIndex(d *sql.DB, term string, userID, limit, offset int) ([]SongResult, error) {
+	rows, err := d.Query(`
+		WITH ranked AS (
+			SELECT ss.song_rowid, bm25(song_search_fts) AS rank, ss.title AS title_sort
+			FROM song_search_fts
+			JOIN song_search ss ON ss.song_rowid = song_search_fts.rowid
+			WHERE song_search_fts MATCH ?
+			ORDER BY rank, title_sort COLLATE NOCASE
+			LIMIT ? OFFSET ?
+		)
+		SELECT s.id, s.title, s.artist, s.album, s.path, s.duration, s.play_count,
+		       s.last_played, COALESCE(s.genre, '') AS genre,
+		       CASE WHEN st.song_id IS NOT NULL THEN 1 ELSE 0 END AS starred
+		FROM ranked
+		JOIN songs s ON s.rowid = ranked.song_rowid
+		LEFT JOIN starred_songs st ON s.id = st.song_id AND st.user_id = ?
+		ORDER BY ranked.rank, ranked.title_sort COLLATE NOCASE`, buildFTSQuery(term), limit, offset, userID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	return scanFastSearchSongs(rows)
+}
+
+func fastSearchSongsFromIndexUnranked(d *sql.DB, term string, userID, limit, offset int) ([]SongResult, error) {
+	prefix := strings.ToLower(term) + "%"
+	contains := "%" + strings.ToLower(term) + "%"
+	ftsQuery := buildFTSQuery(term)
+	rows, err := d.Query(`
+		WITH artist_rank AS (
+			SELECT a.name, bm25(artists_fts) AS rank
+			FROM artists_fts
+			JOIN artists a ON a.rowid = artists_fts.rowid
+			WHERE artists_fts MATCH ?
+			ORDER BY rank, a.name COLLATE NOCASE
+			LIMIT 500
+		),
+		song_candidates AS (
+			SELECT
+				ss.song_rowid,
+				ar.rank AS artist_rank,
+				CASE
+					WHEN lower(ss.title) LIKE ? THEN 0
+					WHEN lower(ss.album) LIKE ? THEN 1
+					WHEN lower(ss.artist) LIKE ? THEN 2
+					WHEN lower(ss.album_artist) LIKE ? THEN 3
+					WHEN lower(ss.title) LIKE ? THEN 4
+					WHEN lower(ss.album) LIKE ? THEN 5
+					WHEN lower(ss.artist) LIKE ? THEN 6
+					WHEN lower(ss.album_artist) LIKE ? THEN 7
+					ELSE 8
+				END AS field_priority,
+				ss.artist AS artist_sort,
+				ss.title AS title_sort,
+				ss.album AS album_sort
+			FROM song_search_fts
+			JOIN song_search ss ON ss.song_rowid = song_search_fts.rowid
+			LEFT JOIN artist_rank ar ON ar.name = ss.artist
+			WHERE song_search_fts MATCH ?
+		),
+		ranked AS (
+			SELECT
+				song_rowid,
+				artist_rank,
+				field_priority,
+				artist_sort,
+				title_sort,
+				album_sort
+			FROM song_candidates
+			ORDER BY
+				CASE WHEN artist_rank IS NULL THEN 1 ELSE 0 END,
+				artist_rank,
+				field_priority,
+				artist_sort COLLATE NOCASE,
+				title_sort COLLATE NOCASE,
+				album_sort COLLATE NOCASE
+			LIMIT ? OFFSET ?
+		)
+		SELECT s.id, s.title, s.artist, s.album, s.path, s.duration, s.play_count,
+		       s.last_played, COALESCE(s.genre, '') AS genre,
+		       CASE WHEN st.song_id IS NOT NULL THEN 1 ELSE 0 END AS starred
+		FROM ranked
+		JOIN songs s ON s.rowid = ranked.song_rowid
+		LEFT JOIN starred_songs st ON s.id = st.song_id AND st.user_id = ?
+		ORDER BY
+		         CASE WHEN ranked.artist_rank IS NULL THEN 1 ELSE 0 END,
+		         ranked.artist_rank,
+		         ranked.field_priority,
+		         ranked.artist_sort COLLATE NOCASE,
+		         ranked.title_sort COLLATE NOCASE, ranked.album_sort COLLATE NOCASE`,
+		ftsQuery,
+		prefix, prefix, prefix, prefix,
+		contains, contains, contains, contains,
+		ftsQuery, limit, offset, userID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	return scanFastSearchSongs(rows)
+}
