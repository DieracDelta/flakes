+fn take_attach_write(
+    control_rx: &mut tokio::sync::mpsc::UnboundedReceiver<AttachControl>,
+) -> Vec<u8> {
+    for _ in 0..16 {
+        match control_rx.try_recv() {
+            Ok(AttachControl::Write(bytes)) => return bytes,
+            Ok(_) => continue,
+            Err(error) => panic!("expected attach write, got {error:?}"),
+        }
+    }
+    panic!("expected attach write, only saw non-write controls");
+}
