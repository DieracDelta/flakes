+
+fn shift_enter_modified_sequence(input: &[u8]) -> Option<(usize, Vec<u8>)> {
+    if input.starts_with(b"\x1b[27;2;13~") {
+        return Some((10, b"\x1b[13;2u".to_vec()));
+    }
+    if !input.starts_with(b"\x1b[") {
+        return None;
+    }
+
+    let end = input
+        .iter()
+        .take(64)
+        .position(|byte| *byte == b'u')?;
+    let payload = std::str::from_utf8(&input[2..end]).ok()?;
+    let mut parts = payload.split(';');
+    if parts.next()? != "13" {
+        return None;
+    }
+    let modifier = parts.next()?;
+    if parts.next().is_some() {
+        return None;
+    }
+    let modifier_value = modifier.split(':').next()?.parse::<u16>().ok()?;
+    let has_shift = modifier_value
+        .checked_sub(1)
+        .is_some_and(|bits| bits & 1 != 0);
+    if !has_shift {
+        return None;
+    }
+
+    Some((end + 1, input[..end + 1].to_vec()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::shift_enter_modified_sequence;
+
+    #[test]
+    fn shift_enter_sequences_preserve_modified_enter() {
+        assert_eq!(
+            shift_enter_modified_sequence(b"\x1b[13;2u"),
+            Some((7, b"\x1b[13;2u".to_vec()))
+        );
+        assert_eq!(
+            shift_enter_modified_sequence(b"\x1b[13;2:1u"),
+            Some((9, b"\x1b[13;2:1u".to_vec()))
+        );
+        assert_eq!(
+            shift_enter_modified_sequence(b"\x1b[13;2:3u"),
+            Some((9, b"\x1b[13;2:3u".to_vec()))
+        );
+        assert_eq!(
+            shift_enter_modified_sequence(b"\x1b[27;2;13~"),
+            Some((10, b"\x1b[13;2u".to_vec()))
+        );
+        assert_eq!(shift_enter_modified_sequence(b"\x1b[13;5u"), None);
+    }
+}
