+#[cfg(unix)]
+fn reset_nice_priority() -> io::Result<()> {
+    let result = unsafe {
+        // SAFETY: This runs in the post-fork child before exec. It changes only
+        // the current process' scheduler nice value back to the normal shell
+        // default so a boosted rmux daemon does not boost every pane workload.
+        libc::setpriority(libc::PRIO_PROCESS, 0, 0)
+    };
+    if result == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
