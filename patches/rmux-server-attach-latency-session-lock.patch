+impl PreparedInitialPaneTerminal {
+    pub(crate) fn open(
+        &self,
+        session_name: &SessionName,
+        command: Option<&ProcessCommand>,
+    ) -> Result<OpenedInitialPaneTerminal, RmuxError> {
+        let terminal = open_pane_terminal(
+            self.pane_geometry,
+            self.profile.clone(),
+            self.runtime_window_name.clone(),
+            command,
+        )?;
+        let output_reader =
+            clone_terminal_for_output_reader(&terminal, session_name, self.pane_id)?;
+        #[cfg(windows)]
+        let exit_watcher =
+            clone_terminal_for_exit_watcher(&terminal, session_name, self.pane_id)?;
+
+        Ok(OpenedInitialPaneTerminal {
+            terminal,
+            output_reader,
+            #[cfg(windows)]
+            exit_watcher,
+        })
+    }
+}
