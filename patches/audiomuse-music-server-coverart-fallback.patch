+// resolveAlbumCoverArtIDForSong returns the representative song ID used as
+// the album cover-art ID. The path-aware lookup avoids conflating distinct
+// albums that happen to share a title.
+func resolveAlbumCoverArtIDForSong(songID string) (string, bool) {
+	if strings.TrimSpace(songID) == "" || db == nil {
+		return "", false
+	}
+
+	var coverArtID string
+	err := db.QueryRow(`
+		SELECT a.id
+		FROM songs s
+		JOIN albums a
+		  ON a.name = COALESCE(s.album, '')
+		 AND a.album_path = COALESCE(s.album_path, '')
+		WHERE s.id = ?
+		  AND s.cancelled = 0
+		  AND a.id != ''
+		LIMIT 1`, songID).Scan(&coverArtID)
+	if err == nil && strings.TrimSpace(coverArtID) != "" {
+		return coverArtID, true
+	}
+	if err != nil && err != sql.ErrNoRows {
+		return "", false
+	}
+
+	// Older databases may not yet have a matching path-aware derived row.
+	err = db.QueryRow(`
+		SELECT a.id
+		FROM songs s
+		JOIN albums a ON a.name = COALESCE(s.album, '')
+		WHERE s.id = ?
+		  AND s.cancelled = 0
+		  AND a.id != ''
+		ORDER BY CASE WHEN a.album_path = COALESCE(s.album_path, '') THEN 0 ELSE 1 END
+		LIMIT 1`, songID).Scan(&coverArtID)
+	return coverArtID, err == nil && strings.TrimSpace(coverArtID) != ""
+}
