+    pub(crate) fn encode_clipboard_osc52_payload(&self, payload: &[u8]) -> Option<Vec<u8>> {
+        if !self.clipboard_writes_enabled {
+            return None;
+        }
+        let template = self.clipboard_template.as_deref()?;
+        let payload = std::str::from_utf8(payload).ok()?;
+        let (selector, encoded) = payload.split_once(';')?;
+        if encoded.is_empty() || encoded == "?" || !is_base64_payload(encoded) {
+            return None;
+        }
+        let rendered = render_string_string_template(template, selector, encoded);
+        Some(rendered.into_bytes())
+    }
