+type streamTranscodeDecision struct {
+	UseTranscoding bool
+	Format         string
+	Bitrate        int
+	ForcedByClient bool
+}
+
+func decideStreamTranscoding(requestFormat, requestMaxBitRate string, savedEnabled bool, savedFormat string, savedBitrate int) (streamTranscodeDecision, error) {
+	requestFormat = strings.ToLower(strings.TrimSpace(requestFormat))
+	requestMaxBitRate = strings.TrimSpace(requestMaxBitRate)
+
+	if requestFormat == "raw" {
+		return streamTranscodeDecision{}, nil
+	}
+
+	if requestFormat != "" {
+		bitrate := savedBitrate
+		if bitrate <= 0 {
+			bitrate = 128
+		}
+		if requestMaxBitRate != "" {
+			parsedBitrate, err := strconv.Atoi(requestMaxBitRate)
+			if err != nil || parsedBitrate <= 0 {
+				return streamTranscodeDecision{}, fmt.Errorf("invalid maxBitRate: %s", requestMaxBitRate)
+			}
+			bitrate = parsedBitrate
+		}
+		return streamTranscodeDecision{UseTranscoding: true, Format: requestFormat, Bitrate: bitrate, ForcedByClient: true}, nil
+	}
+
+	if savedEnabled {
+		format := strings.ToLower(strings.TrimSpace(savedFormat))
+		if format == "" {
+			format = "mp3"
+		}
+		bitrate := savedBitrate
+		if bitrate <= 0 {
+			bitrate = 128
+		}
+		if requestMaxBitRate != "" {
+			parsedBitrate, err := strconv.Atoi(requestMaxBitRate)
+			if err != nil || parsedBitrate <= 0 {
+				return streamTranscodeDecision{}, fmt.Errorf("invalid maxBitRate: %s", requestMaxBitRate)
+			}
+			bitrate = parsedBitrate
+		}
+		return streamTranscodeDecision{UseTranscoding: true, Format: format, Bitrate: bitrate}, nil
+	}
+
+	return streamTranscodeDecision{}, nil
+}
