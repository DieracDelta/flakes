new file mode 100644
index 0000000..397b57e
--- /dev/null
+++ b/music-server-backend/subsonic_song_metadata.go
@@ -0,0 +1,76 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func subsonicSongFromResult(result SongResult) SubsonicSong {
+	s := SubsonicSong{
+		ID:         result.ID,
+		Title:      result.Title,
+		Artist:     result.Artist,
+		ArtistID:   GenerateArtistID(result.Artist),
+		Album:      result.Album,
+		Genre:      result.Genre,
+		Duration:   result.Duration,
+		PlayCount:  result.PlayCount,
+		CoverArt:   result.ID,
+		Starred:    result.Starred,
+		LastPlayed: result.LastPlayed,
+	}
+	enrichSubsonicSong(&s, result.Path)
+	return s
+}
+
+func enrichSubsonicSong(song *SubsonicSong, path string) {
+	if path == "" {
+		return
+	}
+
+	song.Path = path
+
+	suffix := strings.TrimPrefix(strings.ToLower(filepath.Ext(path)), ".")
+	if suffix != "" {
+		song.Suffix = suffix
+		song.ContentType = contentTypeForSuffix(suffix)
+	}
+
+	if info, err := os.Stat(path); err == nil {
+		song.Size = info.Size()
+		if song.Duration > 0 {
+			song.BitRate = int((info.Size() * 8) / int64(song.Duration) / 1000)
+		}
+	}
+}
+
+func contentTypeForSuffix(suffix string) string {
+	switch suffix {
+	case "mp3":
+		return "audio/mpeg"
+	case "flac":
+		return "audio/flac"
+	case "m4a", "mp4":
+		return "audio/mp4"
+	case "aac":
+		return "audio/aac"
+	case "ogg", "oga":
+		return "audio/ogg"
+	case "opus":
+		return "audio/opus"
+	case "wav":
+		return "audio/wav"
+	case "aiff", "aif":
+		return "audio/aiff"
+	case "alac":
+		return "audio/alac"
+	case "wma":
+		return "audio/x-ms-wma"
+	default:
+		if suffix != "" {
+			return "audio/" + suffix
+		}
+		return ""
+	}
+}
