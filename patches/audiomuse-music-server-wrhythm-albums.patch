+package main
+
+import "testing"
+
+func TestDecideStreamTranscodingPlainRequestWithSavedSettingDisabled(t *testing.T) {
+	decision, err := decideStreamTranscoding("", "", false, "mp3", 128)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if decision.UseTranscoding {
+		t.Fatalf("plain stream with saved transcoding disabled should stream original: %+v", decision)
+	}
+}
+
+func TestDecideStreamTranscodingExplicitFormatOverridesSavedSetting(t *testing.T) {
+	decision, err := decideStreamTranscoding("mp3", "320", false, "mp3", 128)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !decision.UseTranscoding || !decision.ForcedByClient {
+		t.Fatalf("explicit format should force transcoding: %+v", decision)
+	}
+	if decision.Format != "mp3" || decision.Bitrate != 320 {
+		t.Fatalf("decision = %+v, want mp3 at 320kbps", decision)
+	}
+}
+
+func TestDecideStreamTranscodingRawDisablesSavedSetting(t *testing.T) {
+	decision, err := decideStreamTranscoding("raw", "320", true, "mp3", 128)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if decision.UseTranscoding {
+		t.Fatalf("format=raw should stream original despite saved transcoding setting: %+v", decision)
+	}
+}
