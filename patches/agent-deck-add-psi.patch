+// buildPsiCommand builds the command for the PSI coding-agent CLI.
+// PSI currently manages its own session file path and opens an interactive
+// REPL when no primary mode flag is supplied, so agent-deck only needs to
+// source the configured shell environment and expose agent-deck metadata.
+func (i *Instance) buildPsiCommand(baseCommand string) string {
+	if i.Tool != "psi" {
+		return baseCommand
+	}
+
+	command := strings.TrimSpace(baseCommand)
+	if command == "" {
+		command = "psi"
+	}
+	command += " --tui --model=openai-codex/gpt-5.5"
+
+	envPrefix := i.buildEnvSourceCommand()
+	envPrefix += fmt.Sprintf("AGENTDECK_INSTANCE_ID=%s AGENTDECK_TITLE=%q AGENTDECK_TOOL=psi ",
+		i.ID, i.Title)
+	return envPrefix + command
+}
