+func TestDetectTool_PSI(t *testing.T) {
+	tests := []struct {
+		name string
+		cmd  string
+		want string
+	}{
+		{"bare", "psi", "psi"},
+		{"with flags", "psi --tui", "psi"},
+		{"uppercase", "PSI", "psi"},
+		{"no match in ellipsis", "ellipsis", "shell"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := detectTool(tt.cmd); got != tt.want {
+				t.Errorf("detectTool(%q) = %q, want %q", tt.cmd, got, tt.want)
+			}
+		})
+	}
+}
