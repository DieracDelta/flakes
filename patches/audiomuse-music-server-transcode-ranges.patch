+func transcodeCachePath(inputPath string, format string, bitrate int) (string, error) {
+	info, err := os.Stat(inputPath)
+	if err != nil {
+		return "", err
+	}
+	key := fmt.Sprintf("%s|%s|%d|%d|%d", inputPath, format, bitrate, info.Size(), info.ModTime().UnixNano())
+	sum := sha1.Sum([]byte(key))
+	dir := filepath.Join(os.TempDir(), "audiomuse-ai-music-server-transcodes")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return "", err
+	}
+	return filepath.Join(dir, hex.EncodeToString(sum[:])+"."+format), nil
+}
 
