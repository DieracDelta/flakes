+
+func getActionRunForAPI(ctx *context.APIContext, runID int64) (*actions_model.ActionRun, bool) {
+	run, err := actions_model.GetRunByID(ctx, runID)
+	if err != nil {
+		if errors.Is(err, util.ErrNotExist) {
+			ctx.Error(http.StatusNotFound, "GetRunByID", err)
+		} else {
+			ctx.Error(http.StatusInternalServerError, "GetRunByID", err)
+		}
+		return nil, false
+	}
+
+	if ctx.Repo().Repository.ID != run.RepoID {
+		ctx.Error(http.StatusNotFound, "GetRunByID", util.ErrNotExist)
+		return nil, false
+	}
+	run.Repo = ctx.Repo().Repository
+
+	return run, true
+}
+
+// ListActionRunJobs returns the jobs for a workflow run.
+func ListActionRunJobs(ctx *context.APIContext) {
+	run, ok := getActionRunForAPI(ctx, ctx.ParamsInt64(":run_id"))
+	if !ok {
+		return
+	}
+
+	jobs, err := actions_model.GetRunJobsByRunID(ctx, run.ID)
+	if err != nil {
+		ctx.Error(http.StatusInternalServerError, "GetRunJobsByRunID", err)
+		return
+	}
+
+	response := make([]*api.ActionRunJob, 0, len(jobs))
+	for _, job := range jobs {
+		response = append(response, convert.ToActionRunJob(job))
+	}
+
+	ctx.JSON(http.StatusOK, response)
+}
+
+func getActionRunJobForAPI(ctx *context.APIContext) (*actions_model.ActionRun, *actions_model.ActionRunJob, bool) {
+	run, ok := getActionRunForAPI(ctx, ctx.ParamsInt64(":run_id"))
+	if !ok {
+		return nil, nil, false
+	}
+
+	job, err := actions_model.GetRunJobByID(ctx, ctx.ParamsInt64(":job_id"))
+	if err != nil {
+		if errors.Is(err, util.ErrNotExist) {
+			ctx.Error(http.StatusNotFound, "GetRunJobByID", err)
+		} else {
+			ctx.Error(http.StatusInternalServerError, "GetRunJobByID", err)
+		}
+		return nil, nil, false
+	}
+	if job.RunID != run.ID || job.RepoID != ctx.Repo().Repository.ID {
+		ctx.Error(http.StatusNotFound, "GetRunJobByID", util.ErrNotExist)
+		return nil, nil, false
+	}
+	job.Run = run
+
+	return run, job, true
+}
+
+func downloadActionRunJobLogs(ctx *context.APIContext, latest bool) {
+	run, job, ok := getActionRunJobForAPI(ctx)
+	if !ok {
+		return
+	}
+
+	attempt := ctx.ParamsInt64(":attempt")
+	if latest {
+		attempt = job.Attempt
+	}
+	if attempt <= 0 {
+		ctx.Error(http.StatusNotFound, "GetTaskByJobAttempt", util.ErrNotExist)
+		return
+	}
+
+	task, err := actions_model.GetTaskByJobAttempt(ctx, job.ID, attempt)
+	if err != nil {
+		if errors.Is(err, util.ErrNotExist) {
+			ctx.Error(http.StatusNotFound, "GetTaskByJobAttempt", err)
+		} else {
+			ctx.Error(http.StatusInternalServerError, "GetTaskByJobAttempt", err)
+		}
+		return
+	}
+	if task.LogExpired {
+		ctx.Error(http.StatusNotFound, "OpenLogs", fmt.Errorf("logs have been cleaned up"))
+		return
+	}
+
+	reader, err := actions_module.OpenLogs(ctx, task.LogInStorage, task.LogFilename)
+	if err != nil {
+		ctx.Error(http.StatusInternalServerError, "OpenLogs", err)
+		return
+	}
+	defer reader.Close()
+
+	workflowName := run.WorkflowID
+	if p := strings.Index(workflowName, "."); p > 0 {
+		workflowName = workflowName[0:p]
+	}
+	ctx.ServeContent(reader, &context.ServeHeaderOptions{
+		Filename:           fmt.Sprintf("%v-%v-%v.log", workflowName, job.Name, task.ID),
+		ContentLength:      &task.LogSize,
+		ContentType:        "text/plain",
+		ContentTypeCharset: "utf-8",
+		Disposition:        "attachment",
+	})
+}
+
+// DownloadActionRunJobAttemptLogs downloads plain-text logs for one job attempt.
+func DownloadActionRunJobAttemptLogs(ctx *context.APIContext) {
+	downloadActionRunJobLogs(ctx, false)
+}
+
+// DownloadActionRunJobLatestLogs downloads plain-text logs for the latest job attempt.
+func DownloadActionRunJobLatestLogs(ctx *context.APIContext) {
+	downloadActionRunJobLogs(ctx, true)
+}
