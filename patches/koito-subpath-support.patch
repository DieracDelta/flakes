diff --git a/client/app/subpath.ts b/client/app/subpath.ts
new file mode 100644
index 0000000..e0fad1c
--- /dev/null
+++ b/client/app/subpath.ts
@@ -0,0 +1,39 @@
+const basePath = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
+const koitoRootPaths = ["/apis/", "/image/", "/images/"];
+
+function shouldPrefix(path: string): boolean {
+  return koitoRootPaths.some((rootPath) => path.startsWith(rootPath));
+}
+
+function withBasePath(path: string): string {
+  if (!basePath || !shouldPrefix(path)) {
+    return path;
+  }
+  if (path === basePath || path.startsWith(`${basePath}/`)) {
+    return path;
+  }
+  return `${basePath}${path}`;
+}
+
+if (typeof window !== "undefined") {
+  const nativeFetch = window.fetch.bind(window);
+
+  window.fetch = (input: RequestInfo | URL, init?: RequestInit) => {
+    if (typeof input === "string") {
+      return nativeFetch(withBasePath(input), init);
+    }
+
+    if (input instanceof URL && input.origin === window.location.origin) {
+      input = new URL(withBasePath(input.pathname) + input.search + input.hash, input.origin);
+      return nativeFetch(input, init);
+    }
+
+    if (input instanceof Request && input.url.startsWith(window.location.origin)) {
+      const url = new URL(input.url);
+      const nextUrl = new URL(withBasePath(url.pathname) + url.search + url.hash, url.origin);
+      input = new Request(nextUrl, input);
+    }
+
+    return nativeFetch(input, init);
+  };
+}
