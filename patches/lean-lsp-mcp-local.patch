@@ -254,6 +254,29 @@ def find_start_position(content: str, query: str) -> dict | None:
     return None
 
 
+def find_all_positions(content: str, query: str) -> List[dict]:
+    """Find all positions of the query in the content.
+
+    Args:
+        content (str): The content to search in.
+        query (str): The query to find.
+
+    Returns:
+        List[dict]: All positions of the query. Each is {"line": int, "column": int}.
+    """
+    positions = []
+    lines = content.splitlines()
+    for line_number, line in enumerate(lines):
+        start = 0
+        while True:
+            char_index = line.find(query, start)
+            if char_index == -1:
+                break
+            positions.append({"line": line_number, "column": char_index})
+            start = char_index + 1
+    return positions
+
