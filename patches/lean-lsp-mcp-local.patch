diff --git a/src/lean_lsp_mcp/devshell.py b/src/lean_lsp_mcp/devshell.py
new file mode 100644
index 0000000..cc35af1
--- /dev/null
+++ b/src/lean_lsp_mcp/devshell.py
@@ -0,0 +1,255 @@
+from __future__ import annotations
+
+import asyncio
+import os
+import subprocess
+from contextlib import contextmanager
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+from tempfile import NamedTemporaryFile
+from typing import Iterator, Sequence
+
+import psutil
+
+
+DEVSHELL_FILE = ".lean_mcp_devshell"
+
+
+@dataclass(frozen=True)
+class DevshellSpec:
+    config_path: Path
+    target: str
+    flake_ref: str
+
+
+def _first_config_line(config_path: Path) -> str | None:
+    for line in config_path.read_text(encoding="utf-8").splitlines():
+        stripped = line.strip()
+        if stripped and not stripped.startswith("#"):
+            return stripped
+    return None
+
+
+def _looks_like_flake_ref(value: str) -> bool:
+    return ":" in value or value.startswith(("/", "~"))
+
+
+def _normalize_flake_ref(target: str, config_dir: Path) -> str:
+    if target.startswith(".#"):
+        return f"{config_dir}{target[1:]}"
+    if target.startswith("#"):
+        return f"{config_dir}{target}"
+
+    if "#" in target:
+        path_part, fragment = target.split("#", 1)
+        if path_part in {"", "."}:
+            return f"{config_dir}#{fragment}"
+        if _looks_like_flake_ref(path_part):
+            return target
+        return f"{(config_dir / path_part).resolve(strict=False)}#{fragment}"
+
+    if _looks_like_flake_ref(target):
+        return target
+
+    return f"{config_dir}#{target}"
+
+
+def find_devshell(project_path: Path | str) -> DevshellSpec | None:
+    current = Path(project_path).expanduser().resolve(strict=False)
+    if current.is_file():
+        current = current.parent
+
+    for directory in (current, *current.parents):
+        config_path = directory / DEVSHELL_FILE
+        if not config_path.is_file():
+            continue
+        target = _first_config_line(config_path)
+        if target is None:
+            return None
+        return DevshellSpec(
+            config_path=config_path,
+            target=target,
+            flake_ref=_normalize_flake_ref(target, directory),
+        )
+
+    return None
+
+
+def command_for_project(
+    project_path: Path | str, command: Sequence[str | Path]
+) -> list[str]:
+    return [str(part) for part in command]
+
+
+def _decode_env_key_value(item: bytes) -> tuple[str, str] | None:
+    if not item or b"=" not in item:
+        return None
+    key, value = item.split(b"=", 1)
+    return (
+        key.decode(errors="surrogateescape"),
+        value.decode(errors="surrogateescape"),
+    )
+
+
+@lru_cache(maxsize=32)
+def _devshell_env(project_path: str) -> dict[str, str] | None:
+    project = Path(project_path).expanduser().resolve(strict=False)
+    spec = find_devshell(project)
+    if spec is None:
+        return None
+
+    with NamedTemporaryFile(prefix="lean-mcp-devshell-env-", delete=False) as env_file:
+        env_path = env_file.name
+
+    try:
+        completed = subprocess.run(
+            [
+                "nix",
+                "develop",
+                spec.flake_ref,
+                "-c",
+                "sh",
+                "-c",
+                'env -0 > "$1"',
+                "sh",
+                env_path,
+            ],
+            cwd=project,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.PIPE,
+            text=True,
+            check=False,
+        )
+        if completed.returncode != 0:
+            raise RuntimeError(
+                f"Failed to evaluate Lean MCP devshell {spec.flake_ref}: "
+                f"{completed.stderr.strip()}"
+            )
+
+        env: dict[str, str] = {}
+        for item in Path(env_path).read_bytes().split(b"\0"):
+            decoded = _decode_env_key_value(item)
+            if decoded is not None:
+                key, value = decoded
+                env[key] = value
+        return env
+    finally:
+        try:
+            Path(env_path).unlink()
+        except FileNotFoundError:
+            pass
+
+
+def env_for_project(
+    project_path: Path | str, base_env: dict[str, str] | None = None
+) -> dict[str, str] | None:
+    env = _devshell_env(str(Path(project_path).expanduser().resolve(strict=False)))
+    if env is None:
+        return base_env
+
+    merged = os.environ.copy()
+    if base_env is not None:
+        merged.update(base_env)
+    merged.update(env)
+    return merged
+
+
+def _kwargs_with_project_env(project_path: Path | str, kwargs: dict) -> dict:
+    updated = dict(kwargs)
+    env = env_for_project(project_path, updated.get("env"))
+    if env is not None:
+        updated["env"] = env
+    return updated
+
+
+def run_for_project(
+    project_path: Path | str, command: Sequence[str | Path], **kwargs
+) -> subprocess.CompletedProcess:
+    return subprocess.run(
+        command_for_project(project_path, command),
+        **_kwargs_with_project_env(project_path, kwargs),
+    )
+
+
+def popen_for_project(
+    project_path: Path | str, command: Sequence[str | Path], **kwargs
+) -> subprocess.Popen:
+    return subprocess.Popen(
+        command_for_project(project_path, command),
+        **_kwargs_with_project_env(project_path, kwargs),
+    )
+
+
+async def create_subprocess_exec_for_project(
+    project_path: Path | str, *command: str | Path, **kwargs
+) -> asyncio.subprocess.Process:
+    return await asyncio.create_subprocess_exec(
+        *command_for_project(project_path, command),
+        **_kwargs_with_project_env(project_path, kwargs),
+    )
+
+
+class _ProjectSubprocessProxy:
+    def __init__(self, wrapped, project_path: Path | str) -> None:
+        self._wrapped = wrapped
+        self._project_path = project_path
+        self.processes: list[subprocess.Popen] = []
+
+    def __getattr__(self, name: str):
+        return getattr(self._wrapped, name)
+
+    def run(self, command: Sequence[str | Path], **kwargs):
+        return self._wrapped.run(
+            command_for_project(self._project_path, command),
+            **_kwargs_with_project_env(self._project_path, kwargs),
+        )
+
+    def Popen(self, command: Sequence[str | Path], **kwargs):
+        proc = self._wrapped.Popen(
+            command_for_project(self._project_path, command),
+            **_kwargs_with_project_env(self._project_path, kwargs),
+        )
+        self.processes.append(proc)
+        return proc
+
+
+def _terminate_process_tree(proc: subprocess.Popen) -> None:
+    if proc.poll() is not None:
+        return
+    try:
+        parent = psutil.Process(proc.pid)
+    except psutil.Error:
+        return
+
+    processes = parent.children(recursive=True) + [parent]
+    for process in processes:
+        try:
+            process.terminate()
+        except psutil.Error:
+            pass
+
+    gone, alive = psutil.wait_procs(processes, timeout=2)
+    _ = gone
+    for process in alive:
+        try:
+            process.kill()
+        except psutil.Error:
+            pass
+
+
+@contextmanager
+def leanclient_subprocess_for_project(project_path: Path | str) -> Iterator[None]:
+    import leanclient.base_client as base_client
+
+    original = base_client.subprocess
+    proxy = _ProjectSubprocessProxy(original, project_path)
+    base_client.subprocess = proxy
+    try:
+        yield
+    except Exception:
+        for proc in proxy.processes:
+            _terminate_process_tree(proc)
+        raise
+    finally:
+        base_client.subprocess = original
