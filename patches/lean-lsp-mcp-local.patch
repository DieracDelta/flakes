diff --git a/src/lean_lsp_mcp/devshell.py b/src/lean_lsp_mcp/devshell.py
new file mode 100644
index 0000000..2efbdac
--- /dev/null
+++ b/src/lean_lsp_mcp/devshell.py
@@ -0,0 +1,208 @@
+from __future__ import annotations
+
+import asyncio
+import os
+import shutil
+import subprocess
+import sys
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+from tempfile import NamedTemporaryFile
+from typing import Sequence
+
+
+DEVSHELL_FILE = ".lean_mcp_devshell"
+
+
+@dataclass(frozen=True)
+class DevshellSpec:
+    config_path: Path
+    target: str
+    flake_ref: str
+
+
+def _first_config_line(config_path: Path) -> str | None:
+    for line in config_path.read_text(encoding="utf-8").splitlines():
+        stripped = line.strip()
+        if stripped and not stripped.startswith("#"):
+            return stripped
+    return None
+
+
+def _looks_like_flake_ref(value: str) -> bool:
+    return ":" in value or value.startswith(("/", "~"))
+
+
+def _normalize_flake_ref(target: str, config_dir: Path) -> str:
+    if target.startswith(".#"):
+        return f"{config_dir}{target[1:]}"
+    if target.startswith("#"):
+        return f"{config_dir}{target}"
+
+    if "#" in target:
+        path_part, fragment = target.split("#", 1)
+        if path_part in {"", "."}:
+            return f"{config_dir}#{fragment}"
+        if _looks_like_flake_ref(path_part):
+            return target
+        return f"{(config_dir / path_part).resolve(strict=False)}#{fragment}"
+
+    if _looks_like_flake_ref(target):
+        return target
+
+    return f"{config_dir}#{target}"
+
+
+def find_devshell(project_path: Path | str) -> DevshellSpec | None:
+    current = Path(project_path).expanduser().resolve(strict=False)
+    if current.is_file():
+        current = current.parent
+
+    for directory in (current, *current.parents):
+        config_path = directory / DEVSHELL_FILE
+        if not config_path.is_file():
+            continue
+        target = _first_config_line(config_path)
+        if target is None:
+            return None
+        return DevshellSpec(
+            config_path=config_path,
+            target=target,
+            flake_ref=_normalize_flake_ref(target, directory),
+        )
+
+    return None
+
+
+def _decode_env_key_value(item: bytes) -> tuple[str, str] | None:
+    if not item or b"=" not in item:
+        return None
+    key, value = item.split(b"=", 1)
+    return (
+        key.decode(errors="surrogateescape"),
+        value.decode(errors="surrogateescape"),
+    )
+
+
+@lru_cache(maxsize=32)
+def _devshell_env(project_path: str) -> dict[str, str] | None:
+    project = Path(project_path).expanduser().resolve(strict=False)
+    spec = find_devshell(project)
+    if spec is None:
+        return None
+
+    with NamedTemporaryFile(prefix="lean-mcp-devshell-env-", delete=False) as env_file:
+        env_path = env_file.name
+
+    try:
+        completed = subprocess.run(
+            [
+                "nix",
+                "develop",
+                spec.flake_ref,
+                "-c",
+                "sh",
+                "-c",
+                'env -0 > "$1"',
+                "sh",
+                env_path,
+            ],
+            cwd=project,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.PIPE,
+            text=True,
+            check=False,
+        )
+        if completed.returncode != 0:
+            raise RuntimeError(
+                f"Failed to evaluate Lean MCP devshell {spec.flake_ref}: "
+                f"{completed.stderr.strip()}"
+            )
+
+        env: dict[str, str] = {}
+        for item in Path(env_path).read_bytes().split(b"\0"):
+            decoded = _decode_env_key_value(item)
+            if decoded is not None:
+                key, value = decoded
+                env[key] = value
+        return env
+    finally:
+        try:
+            Path(env_path).unlink()
+        except FileNotFoundError:
+            pass
+
+
+def env_for_project(
+    project_path: Path | str, base_env: dict[str, str] | None = None
+) -> dict[str, str] | None:
+    env = _devshell_env(str(Path(project_path).expanduser().resolve(strict=False)))
+    if env is None:
+        return base_env
+
+    merged = os.environ.copy()
+    if base_env is not None:
+        merged.update(base_env)
+    merged.update(env)
+    return merged
+
+
+def _kwargs_with_project_env(project_path: Path | str, kwargs: dict) -> dict:
+    updated = dict(kwargs)
+    env = env_for_project(project_path, updated.get("env"))
+    if env is not None:
+        updated["env"] = env
+    return updated
+
+
+def command_for_project(
+    project_path: Path | str, command: Sequence[str | Path]
+) -> list[str]:
+    rendered = [str(part) for part in command]
+    if find_devshell(project_path) is None:
+        return rendered
+    project = str(Path(project_path).expanduser().resolve(strict=False))
+    if runner := shutil.which("lean-lsp-mcp-devshell-exec"):
+        return [runner, "--exec", project, *rendered]
+    return [
+        sys.executable,
+        "-m",
+        "lean_lsp_mcp.devshell",
+        "--exec",
+        project,
+        *rendered,
+    ]
+
+
+def run_for_project(
+    project_path: Path | str, command: Sequence[str | Path], **kwargs
+) -> subprocess.CompletedProcess:
+    return subprocess.run(
+        [str(part) for part in command],
+        **_kwargs_with_project_env(project_path, kwargs),
+    )
+
+
+async def create_subprocess_exec_for_project(
+    project_path: Path | str, *command: str | Path, **kwargs
+) -> asyncio.subprocess.Process:
+    return await asyncio.create_subprocess_exec(
+        *(str(part) for part in command),
+        **_kwargs_with_project_env(project_path, kwargs),
+    )
+
+
+def devshell_exec_main() -> None:
+    if len(sys.argv) < 4 or sys.argv[1] != "--exec":
+        raise SystemExit(
+            "usage: lean-lsp-mcp-devshell-exec --exec PROJECT COMMAND [ARG ...]"
+        )
+    project_path = sys.argv[2]
+    command = sys.argv[3:]
+    env = env_for_project(project_path) or os.environ.copy()
+    os.execvpe(command[0], command, env)
+
+
+if __name__ == "__main__":
+    devshell_exec_main()
diff --git a/tests/unit/test_devshell.py b/tests/unit/test_devshell.py
new file mode 100644
index 0000000..00523eb
--- /dev/null
+++ b/tests/unit/test_devshell.py
@@ -0,0 +1,73 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+from lean_lsp_mcp.devshell import command_for_project, env_for_project, find_devshell
+
+
+def test_find_devshell_walks_up_from_nested_project(tmp_path: Path) -> None:
+    repo = tmp_path / "repo"
+    project = repo / "lean-mock"
+    project.mkdir(parents=True)
+    (repo / ".lean_mcp_devshell").write_text(".#lean-mock\n", encoding="utf-8")
+
+    spec = find_devshell(project)
+
+    assert spec is not None
+    assert spec.config_path == repo / ".lean_mcp_devshell"
+    assert spec.flake_ref == f"{repo}#lean-mock"
+
+
+def test_devshell_accepts_relative_flake_path(tmp_path: Path) -> None:
+    repo = tmp_path / "repo"
+    project = repo / "formalization"
+    project.mkdir(parents=True)
+    (project / ".lean_mcp_devshell").write_text("../..#lean\n", encoding="utf-8")
+
+    spec = find_devshell(project)
+
+    assert spec is not None
+    assert spec.flake_ref == f"{tmp_path.resolve()}#lean"
+
+
+def test_command_for_project_wraps_configured_devshell(
+    monkeypatch, tmp_path: Path
+) -> None:
+    project = tmp_path / "proj"
+    project.mkdir()
+    (project / ".lean_mcp_devshell").write_text(".#lean\n", encoding="utf-8")
+    monkeypatch.setattr(
+        "lean_lsp_mcp.devshell.shutil.which",
+        lambda _: "/nix/store/example/bin/lean-lsp-mcp-devshell-exec",
+    )
+
+    assert command_for_project(project, ["lake", "serve"]) == [
+        "/nix/store/example/bin/lean-lsp-mcp-devshell-exec",
+        "--exec",
+        str(project),
+        "lake",
+        "serve",
+    ]
+
+
+def test_command_for_project_falls_back_without_config(tmp_path: Path) -> None:
+    project = tmp_path / "proj"
+    project.mkdir()
+
+    assert command_for_project(project, ["lake", "serve"]) == ["lake", "serve"]
+
+
+def test_env_for_project_merges_devshell_env(monkeypatch, tmp_path: Path) -> None:
+    project = tmp_path / "proj"
+    project.mkdir()
+    monkeypatch.setattr(
+        "lean_lsp_mcp.devshell._devshell_env",
+        lambda _: {"PATH": "/nix/bin", "IN_NIX_SHELL": "impure"},
+    )
+
+    env = env_for_project(project, {"PATH": "/base/bin", "KEEP": "1"})
+
+    assert env is not None
+    assert env["PATH"] == "/nix/bin"
+    assert env["IN_NIX_SHELL"] == "impure"
+    assert env["KEEP"] == "1"
