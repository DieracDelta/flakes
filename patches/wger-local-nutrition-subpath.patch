+def detect_fermented(product_data: dict) -> bool:
+    """
+    Detect if product is fermented based on categories and name
+    """
+    # Check categories
+    categories = set(product_data.get('categories_tags', []))
+    # Remove 'en:' prefix if present
+    categories = {c.replace('en:', '') for c in categories}
+
+    if categories & FERMENTED_CATEGORIES:
+        return True
+
+    # Check product name and generic name
+    name = (
+        product_data.get('product_name', '') + ' ' + product_data.get('generic_name', '')
+    ).lower()
+
+    return any(kw in name for kw in FERMENTED_KEYWORDS)
+
+
+def get_nutrient(nutriments: dict, key: str, default=None):
+    """Safely get a nutrient value from the nutriments dict"""
+    value = nutriments.get(key)
+    if value is not None:
+        try:
+            return float(value)
+        except (ValueError, TypeError):
+            return default
+    return default
+
