+def convert_to_mg(entry: dict) -> float:
+    """
+    Convert a nutrient entry to milligrams
+    """
+    nutrient = entry['nutrient']
+    amount = float(entry['amount'])
+    unit = nutrient['unitName'].lower()
+
+    if unit == 'mg':
+        return amount
+    elif unit == 'g':
+        return amount * 1000
+    elif unit in ('mcg', 'ug', 'µg'):
+        return amount / 1000
+    else:
+        # Return as-is for unknown units
+        return amount
+
+
+def convert_to_mcg(entry: dict) -> float:
+    """
+    Convert a nutrient entry to micrograms
+    """
+    nutrient = entry['nutrient']
+    amount = float(entry['amount'])
+    unit = nutrient['unitName'].lower()
+
+    if unit in ('mcg', 'ug', 'µg'):
+        return amount
+    elif unit == 'mg':
+        return amount * 1000
+    elif unit == 'g':
+        return amount * 1000000
+    else:
+        # Return as-is for unknown units
+        return amount
+
