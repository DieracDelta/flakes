+#!/usr/bin/env python3
+"""
+Fetch soluble/insoluble fiber data from USDA FoodData Central and update wger ingredients.
+
+Usage:
+    python update_fiber_data.py --api-key YOUR_USDA_API_KEY --wger-token YOUR_WGER_TOKEN
+
+Get a free USDA API key at: https://fdc.nal.usda.gov/api-key-signup.html
+"""
+
+import argparse
+import requests
+import time
+import sys
+
+# USDA FoodData Central API
+USDA_API_BASE = "https://api.nal.usda.gov/fdc/v1"
+
+# USDA Nutrient IDs
+NUTRIENT_IDS = {
+    "fiber": 1079,           # Fiber, total dietary
+    "fiber_soluble": 1082,   # Fiber, soluble
+    "fiber_insoluble": 1084, # Fiber, insoluble
+    # Antioxidants/Flavonoids (from USDA Flavonoid Database)
+    "quercetin": 1159,       # Quercetin
+    "catechins": 1160,       # (+)-Catechin (we'll sum catechin types)
+    "epicatechin": 1161,     # (-)-Epicatechin
+    "anthocyanins": 1165,    # Cyanidin (main anthocyanin, proxy for total)
+    "kaempferol": 1166,      # Kaempferol
+    "total_flavonoids": 1159,# Will calculate from components
+    # Additional catechin types to sum
+    "catechin": 1160,
+    "epicatechin_3_gallate": 1162,
+    "epigallocatechin": 1163,
+    "epigallocatechin_3_gallate": 1164,
+    # Caffeine
+    "caffeine": 1057,
+}
+
+# wger API
+WGER_API_BASE = "http://127.0.0.1:8002/api/v2"
+
+
+def get_used_ingredient_ids(wger_token: str) -> set:
+    """Get IDs of ingredients used in diary entries."""
+    ids = set()
+    headers = {"Authorization": f"Token {wger_token}"}
+
+    # Check nutrition diary (log items)
+    url = f"{WGER_API_BASE}/nutritiondiary/?limit=500"
+    while url:
+        resp = requests.get(url, headers=headers)
+        resp.raise_for_status()
+        data = resp.json()
+        for entry in data.get("results", []):
+            if entry.get("ingredient"):
+                ids.add(entry["ingredient"])
+        next_url = data.get("next")
+        if next_url and "/wger/api/v2/" in next_url:
+            next_url = next_url.replace("/wger/api/v2/", "/api/v2/")
+        url = next_url
+        time.sleep(0.05)
+
+    # Check meal items in nutrition plans
+    url = f"{WGER_API_BASE}/mealitem/?limit=500"
+    while url:
+        resp = requests.get(url, headers=headers)
+        resp.raise_for_status()
+        data = resp.json()
+        for item in data.get("results", []):
+            if item.get("ingredient"):
+                ids.add(item["ingredient"])
+        next_url = data.get("next")
+        if next_url and "/wger/api/v2/" in next_url:
+            next_url = next_url.replace("/wger/api/v2/", "/api/v2/")
+        url = next_url
+        time.sleep(0.05)
+
+    return ids
+
+
+def get_wger_ingredients(wger_token: str, limit: int = None, only_used: bool = False) -> list:
+    """Fetch ingredients from wger API with optional limit."""
+    ingredients = []
+    headers = {"Authorization": f"Token {wger_token}"}
+
+    # If only_used, get the list of ingredient IDs first
+    used_ids = None
+    if only_used:
+        print("Finding ingredients used in your diary/meal plans...")
+        used_ids = get_used_ingredient_ids(wger_token)
+        print(f"Found {len(used_ids)} unique ingredients in use")
+        if not used_ids:
+            return []
+        # Fetch each ingredient by ID
+        for ing_id in used_ids:
+            url = f"{WGER_API_BASE}/ingredient/{ing_id}/"
+            try:
+                resp = requests.get(url, headers=headers)
+                resp.raise_for_status()
+                ingredients.append(resp.json())
+            except Exception as e:
+                print(f"  Error fetching ingredient {ing_id}: {e}")
+            if limit and len(ingredients) >= limit:
+                break
+            time.sleep(0.05)
+        return ingredients
+
+    # Otherwise paginate through all
+    url = f"{WGER_API_BASE}/ingredient/?limit=100"
+
+    while url:
+        print(f"Fetching ingredients... (got {len(ingredients)} so far)")
+        resp = requests.get(url, headers=headers)
+        resp.raise_for_status()
+        data = resp.json()
+        ingredients.extend(data.get("results", []))
+
+        # Stop early if we have enough
+        if limit and len(ingredients) >= limit:
+            ingredients = ingredients[:limit]
+            break
+
+        # Handle pagination URLs that may have different base path
+        next_url = data.get("next")
+        if next_url:
+            # Normalize URL to use our base
+            if "/wger/api/v2/" in next_url:
+                next_url = next_url.replace("/wger/api/v2/", "/api/v2/")
+            url = next_url
+        else:
+            url = None
+        time.sleep(0.05)  # Rate limiting
+
+    return ingredients
+
+
+def search_usda_food(name: str, api_key: str) -> dict | None:
+    """Search USDA FoodData Central for a food by name."""
+    url = f"{USDA_API_BASE}/foods/search"
+    params = {
+        "api_key": api_key,
+        "query": name,
+        "dataType": ["SR Legacy", "Foundation"],  # Prefer these databases
+        "pageSize": 5,
+    }
+
+    try:
+        resp = requests.get(url, params=params)
+        resp.raise_for_status()
+        data = resp.json()
+
+        foods = data.get("foods", [])
+        if foods:
+            # Return the first match
+            return foods[0]
+    except Exception as e:
+        print(f"  Error searching USDA for '{name}': {e}")
+
+    return None
+
+
+def get_usda_food_nutrients(fdc_id: int, api_key: str) -> dict:
+    """Get detailed nutrient data for a USDA food."""
+    url = f"{USDA_API_BASE}/food/{fdc_id}"
+    params = {"api_key": api_key}
+
+    try:
+        resp = requests.get(url, params=params)
+        resp.raise_for_status()
+        return resp.json()
+    except Exception as e:
+        print(f"  Error fetching USDA food {fdc_id}: {e}")
+        return {}
+
+
+def extract_nutrient_data(food_data: dict) -> dict:
+    """Extract fiber, antioxidants, and caffeine from USDA food data."""
+    result = {
+        "fiber_soluble": None,
+        "fiber_insoluble": None,
+        "quercetin": None,
+        "catechins": None,
+        "epicatechin": None,
+        "anthocyanins": None,
+        "kaempferol": None,
+        "caffeine": None,
+    }
+
+    nutrients = food_data.get("foodNutrients", [])
+
+    # For catechins, we'll sum multiple types
+    catechin_total = 0.0
+    catechin_found = False
+
+    for nutrient in nutrients:
+        # Handle different response formats
+        nutrient_id = nutrient.get("nutrient", {}).get("id") or nutrient.get("nutrientId")
+        amount = nutrient.get("amount")
+
+        if amount is None:
+            continue
+
+        if nutrient_id == NUTRIENT_IDS["fiber_soluble"]:
+            result["fiber_soluble"] = float(amount)
+        elif nutrient_id == NUTRIENT_IDS["fiber_insoluble"]:
+            result["fiber_insoluble"] = float(amount)
+        elif nutrient_id == NUTRIENT_IDS["quercetin"]:
+            result["quercetin"] = float(amount)
+        elif nutrient_id == NUTRIENT_IDS["epicatechin"]:
+            result["epicatechin"] = float(amount)
+        elif nutrient_id == NUTRIENT_IDS["anthocyanins"]:
+            result["anthocyanins"] = float(amount)
+        elif nutrient_id == NUTRIENT_IDS["kaempferol"]:
+            result["kaempferol"] = float(amount)
+        elif nutrient_id == NUTRIENT_IDS["caffeine"]:
+            result["caffeine"] = float(amount)
+        # Sum all catechin types
+        elif nutrient_id in [1160, 1161, 1162, 1163, 1164]:
+            catechin_total += float(amount)
+            catechin_found = True
+
+    if catechin_found:
+        result["catechins"] = catechin_total
+
+    return result
+
+
+def update_wger_ingredient(ingredient_id: int, nutrient_data: dict, wger_token: str) -> bool:
+    """Update a wger ingredient with nutrient data."""
+    url = f"{WGER_API_BASE}/ingredient/{ingredient_id}/"
+    headers = {
+        "Authorization": f"Token {wger_token}",
+        "Content-Type": "application/json",
+    }
+
+    data = {}
+    field_mapping = {
+        "fiber_soluble": "fiber_soluble",
+        "fiber_insoluble": "fiber_insoluble",
+        "quercetin": "quercetin",
+        "catechins": "catechins",
+        "epicatechin": "epicatechin",
+        "anthocyanins": "anthocyanins",
+        "kaempferol": "kaempferol",
+        "caffeine": "caffeine",
+    }
+
+    for key, api_field in field_mapping.items():
+        if nutrient_data.get(key) is not None:
+            data[api_field] = str(nutrient_data[key])
+
+    if not data:
+        return False
+
+    try:
+        resp = requests.patch(url, json=data, headers=headers)
+        resp.raise_for_status()
+        return True
+    except Exception as e:
+        print(f"  Error updating ingredient {ingredient_id}: {e}")
+        return False
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Update wger ingredients with USDA nutrient data (fiber, antioxidants, caffeine)")
+    parser.add_argument("--usda-api-key", required=True, help="USDA FoodData Central API key")
+    parser.add_argument("--wger-token", required=True, help="wger API token")
+    parser.add_argument("--dry-run", action="store_true", help="Don't actually update, just show what would be done")
+    parser.add_argument("--limit", type=int, help="Limit number of ingredients to process")
+    parser.add_argument("--force", action="store_true", help="Update even if ingredient already has some data")
+    parser.add_argument("--only-used", action="store_true", help="Only process ingredients used in your diary/meal plans")
+    args = parser.parse_args()
+
+    print("Fetching ingredients from wger...")
+    ingredients = get_wger_ingredients(args.wger_token, limit=args.limit, only_used=args.only_used)
+    print(f"Fetched {len(ingredients)} ingredients\n")
+
+    updated = 0
+    skipped = 0
+    no_data = 0
+
+    for i, ing in enumerate(ingredients):
+        ing_id = ing["id"]
+        ing_name = ing["name"]
+
+        # Skip if already has data (unless --force)
+        has_data = any([
+            ing.get("fiber_soluble") is not None,
+            ing.get("fiber_insoluble") is not None,
+            ing.get("quercetin") is not None,
+            ing.get("catechins") is not None,
+            ing.get("caffeine") is not None,
+        ])
+        if has_data and not args.force:
+            print(f"[{i+1}/{len(ingredients)}] {ing_name}: Already has nutrient data, skipping (use --force to update)")
+            skipped += 1
+            continue
+
+        print(f"[{i+1}/{len(ingredients)}] {ing_name}:")
+
+        # Search USDA
+        usda_food = search_usda_food(ing_name, args.usda_api_key)
+        if not usda_food:
+            print(f"  No USDA match found")
+            no_data += 1
+            continue
+
+        fdc_id = usda_food.get("fdcId")
+        usda_name = usda_food.get("description", "Unknown")
+        print(f"  Matched to: {usda_name} (FDC ID: {fdc_id})")
+
+        # Get detailed nutrients
+        food_data = get_usda_food_nutrients(fdc_id, args.usda_api_key)
+        nutrient_data = extract_nutrient_data(food_data)
+
+        # Check if we got any useful data
+        has_useful_data = any(v is not None for v in nutrient_data.values())
+        if not has_useful_data:
+            print(f"  No nutrient data found in USDA")
+            no_data += 1
+            continue
+
+        # Print what we found
+        found_nutrients = [f"{k}={v}" for k, v in nutrient_data.items() if v is not None]
+        print(f"  Found: {', '.join(found_nutrients)}")
+
+        if args.dry_run:
+            print(f"  [DRY RUN] Would update ingredient {ing_id}")
+            updated += 1
+        else:
+            if update_wger_ingredient(ing_id, nutrient_data, args.wger_token):
+                print(f"  Updated!")
+                updated += 1
+            else:
+                print(f"  Failed to update")
+
+        # Rate limiting for USDA API
+        time.sleep(0.5)
+
+    print(f"\n--- Summary ---")
+    print(f"Updated: {updated}")
+    print(f"Skipped (already had data): {skipped}")
+    print(f"No USDA data available: {no_data}")
+
+
+if __name__ == "__main__":
+    main()
