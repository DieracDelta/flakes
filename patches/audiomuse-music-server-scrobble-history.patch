+func subsonicScrobble(c *gin.Context) {
+	user := c.MustGet("user").(User)
+
+	songID := c.Query("id")
+	if songID == "" {
+		subsonicRespond(c, newSubsonicResponse(nil))
+		return
+	}
+
+	playedAt := time.Now()
+	if timeParam := c.Query("time"); timeParam != "" {
+		if unixMillis, err := strconv.ParseInt(timeParam, 10, 64); err == nil && unixMillis > 0 {
+			playedAt = time.UnixMilli(unixMillis)
+		} else {
+			log.Printf("Ignoring invalid Subsonic scrobble time parameter %q for song '%s'", timeParam, songID)
+		}
+	}
+	now := playedAt.Format(time.RFC3339)
+	submission := strings.ToLower(c.DefaultQuery("submission", "true")) != "false"
+
+	if submission {
+		err := UpdateSongPlayCount(db, songID, now)
+		if err != nil {
+			log.Printf("Error updating play count for user '%s' on song '%s': %v", user.Username, songID, err)
+		}
+
+		// Track play history for this user
+		err = InsertPlayHistory(db, user.ID, songID, now)
+		if err != nil {
+			log.Printf("Error inserting play history for user '%s' on song '%s': %v", user.Username, songID, err)
+		}
+	}
+
+	// Keep a lightweight now-playing view for Subsonic clients such as multi-scrobbler.
+	// Do not let historical imports with old timestamps appear as currently playing.
+	if time.Since(playedAt) >= 0 && time.Since(playedAt) < 24*time.Hour {
+		playerID := c.Query("playerId")
+		if playerID == "" {
+			playerID = user.Username
+		}
+		nowPlayingMu.Lock()
+		nowPlayingByUser[user.ID] = nowPlayingState{
+			SongID:    songID,
+			UserID:    user.ID,
+			Username:  user.Username,
+			StartedAt: playedAt,
+			PlayerID:  playerID,
+		}
+		nowPlayingMu.Unlock()
+	}
+
+	if submission {
+		log.Printf("Scrobbled song '%s' for user '%s' at %s", songID, user.Username, now)
+	} else {
+		log.Printf("Updated now playing song '%s' for user '%s'", songID, user.Username)
+	}
+	subsonicRespond(c, newSubsonicResponse(nil))
+}
+
+func subsonicGetNowPlaying(c *gin.Context) {
+	now := time.Now()
+
+	nowPlayingMu.Lock()
+	states := make([]nowPlayingState, 0, len(nowPlayingByUser))
+	for userID, state := range nowPlayingByUser {
+		if now.Sub(state.StartedAt) > 24*time.Hour {
+			delete(nowPlayingByUser, userID)
+			continue
+		}
+		states = append(states, state)
+	}
+	nowPlayingMu.Unlock()
+
+	entries := make([]SubsonicNowPlayingEntry, 0, len(states))
+	for _, state := range states {
+		var title, artist, album string
+		var duration, playCount int
+		var lastPlayed sql.NullString
+
+		err := db.QueryRow(`
+			SELECT title, artist, album, COALESCE(duration, 0), play_count, last_played
+			FROM songs
+			WHERE id = ? AND cancelled = 0
+		`, state.SongID).Scan(&title, &artist, &album, &duration, &playCount, &lastPlayed)
+		if err != nil {
+			continue
+		}
+
+		activeFor := time.Duration(duration+300) * time.Second
+		if duration <= 0 {
+			activeFor = 30 * time.Minute
+		}
+		if now.Sub(state.StartedAt) > activeFor {
+			nowPlayingMu.Lock()
+			if current, ok := nowPlayingByUser[state.UserID]; ok && current.SongID == state.SongID && current.StartedAt.Equal(state.StartedAt) {
+				delete(nowPlayingByUser, state.UserID)
+			}
+			nowPlayingMu.Unlock()
+			continue
+		}
+
+		entries = append(entries, SubsonicNowPlayingEntry{
+			ID:         state.SongID,
+			CoverArt:   state.SongID,
+			Title:      title,
+			Artist:     artist,
+			Album:      album,
+			Duration:   duration,
+			PlayCount:  playCount,
+			LastPlayed: lastPlayed.String,
+			MinutesAgo: int(now.Sub(state.StartedAt).Minutes()),
+			PlayerID:   state.PlayerID,
+			Username:   state.Username,
+		})
+	}
+
+	subsonicRespond(c, newSubsonicResponse(&SubsonicNowPlaying{Entries: entries}))
+}
