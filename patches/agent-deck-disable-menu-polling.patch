+func (h *Home) renderGroupSwitcherView() string {
+	var b strings.Builder
+	title := "Agent Deck"
+	if h.profile != "" && h.profile != session.DefaultProfile {
+		title += " [" + h.profile + "]"
+	}
+	if h.groupScope != "" {
+		title += " [" + h.groupScopeDisplayName() + "]"
+	}
+	b.WriteString(cellTruncate(title, max(0, h.width), ""))
+	b.WriteString("\n")
+
+	available := h.height - 1
+	if available < 1 {
+		return clampViewToViewport(b.String(), h.width, h.height)
+	}
+	if len(h.flatItems) == 0 {
+		b.WriteString(cellTruncate("No groups", max(0, h.width), ""))
+		return clampViewToViewport(b.String(), h.width, h.height)
+	}
+
+	maxVisible := available
+	if h.viewOffset > 0 && maxVisible > 0 {
+		b.WriteString(cellTruncate(fmt.Sprintf("  +%d above", h.viewOffset), max(0, h.width), ""))
+		b.WriteString("\n")
+		maxVisible--
+	}
+
+	visible := 0
+	for i := h.viewOffset; i < len(h.flatItems) && visible < maxVisible; i++ {
+		item := h.flatItems[i]
+		if item.Type != session.ItemTypeGroup || item.Group == nil {
+			continue
+		}
+
+		marker := " "
+		if i == h.cursor {
+			marker = ">"
+		}
+		icon := "-"
+		if item.Group.Expanded {
+			icon = "v"
+		} else {
+			icon = ">"
+		}
+		hotkey := ""
+		if item.Level == 0 && item.RootGroupNum >= 1 && item.RootGroupNum <= 9 {
+			hotkey = fmt.Sprintf("%d ", item.RootGroupNum)
+		}
+		indent := strings.Repeat("  ", max(0, item.Level))
+		line := fmt.Sprintf("%s %s%s%s %s", marker, indent, hotkey, icon, item.Group.Name)
+		b.WriteString(cellTruncate(line, max(0, h.width), ""))
+		b.WriteString("\n")
+		visible++
+	}
+
+	remaining := len(h.flatItems) - (h.viewOffset + visible)
+	if remaining > 0 && visible < available {
+		b.WriteString(cellTruncate(fmt.Sprintf("  +%d below", remaining), max(0, h.width), ""))
+	}
+
+	return clampViewToViewport(b.String(), h.width, h.height)
+}
